{
  "$comment": "Mixins declared by the demo-hud mod (M5-A). A mod authors Tier-2 patches here instead of the loader hardcoding them. Inline anchors for now (mappings-resolved targeting is M5-C). This one injects a visible 'demo-hud mixin' marker via `after` on the Car module factory, proving a mod-declared mixin applies.",
  "patches": [
    {
      "op": "after",
      "target": {
        "anchor": { "literals": ["CreateCar", "ControlCar", "TestDeterminism"], "minHits": 3 },
        "selector": { "kind": "factory" }
      },
      "inject": "(function(){try{if(typeof window!=='undefined'){window.__demoHudMixin=true;if(typeof document!=='undefined'&&!document.getElementById('tspml-demo-hud-mixin')){var m=document.createElement('div');m.id='tspml-demo-hud-mixin';m.textContent='demo-hud mixin';m.style.cssText='position:fixed;top:0;right:0;z-index:2147483647;background:#1a0a2e;color:#c792ea;font:600 13px ui-monospace,Menlo,monospace;padding:6px 10px;border-bottom-left-radius:6px;pointer-events:none';(document.body||document.documentElement).appendChild(m);}}}catch(e){}})();"
    }
  ]
}
