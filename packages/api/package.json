{
  "name": "@tspml/api",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript type definitions for the TSPML stable game surface — gives modders autocomplete against stable names. Zero runtime.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "keywords": ["polytrack", "tspml", "modding", "types", "game-mods"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roowus/TSPML.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

