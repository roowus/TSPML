{
  "name": "@tspml/loader",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Clean loader core. Discovers mod packages, parses mod.json, semver-resolves dependencies, topologically orders mods, and invokes entrypoints. Has no coupling to minified game internals.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tspml/api": "workspace:*",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
