{
  "name": "@tspml/transform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Babel AST transform pipeline applying mappings-resolved mixin patches (before/after/around/replace/modifyArg/modifyReturn/modifyConstant) to game bundles before they execute; fail-closed on bundle-hash mismatch.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spike": "./src/spike.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "spike": "node src/spike.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@tspml/mappings": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
